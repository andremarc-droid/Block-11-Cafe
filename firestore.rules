rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Raw Materials Collection
    // Used for listing, creating, editing, and restocking inventory items
    match /rawMaterials/{materialId} {
      // Authenticated users (staff/admin) can view materials
      allow read: if isAuthenticated();

      // Creating a new raw material
      allow create: if isAuthenticated()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.stockQty is number
        && request.resource.data.stockQty >= 0
        && request.resource.data.costPerUnit is number
        && request.resource.data.costPerUnit >= 0
        && request.resource.data.minStockAlert is number
        && request.resource.data.minStockAlert >= 0
        && request.resource.data.createdBy == request.auth.uid;

      // Updating a raw material (via Edit modal or Restock transaction)
      allow update: if isAuthenticated()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockQty']) || (request.resource.data.stockQty is number && request.resource.data.stockQty >= 0))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['costPerUnit']) || (request.resource.data.costPerUnit is number && request.resource.data.costPerUnit >= 0));

      // Deleting a raw material
      allow delete: if isAuthenticated();
    }

    // 2. Stock Movements Collection
    // Audit log written during restocking (restockMaterial)
    match /stockMovements/{movementId} {
      // Authenticated users can view movement logs
      allow read: if isAuthenticated();

      // Only authenticated users can record stock movements matching their user ID
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rawMaterialId is string
        && request.resource.data.changeQty is number
        && request.resource.data.changeQty > 0
        && request.resource.data.costPerUnitAtTime is number
        && request.resource.data.costPerUnitAtTime >= 0
        && request.resource.data.movementType is string;

      // Stock movements are immutable audit records: no edits or deletions allowed
      allow update, delete: if false;
    }

    // 3. Categories Collection
    // Read-only for authenticated users
    match /categories/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 4. Menu Items Collection
    // Menu items can be read, created, or updated by authenticated users (no deletes allowed)
    match /menuItems/{id} {
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated()
        && request.resource.data.sku is string
        && request.resource.data.sku.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.categoryId is number
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // 5. Counters Collection
    // Only menuItemId counter document may be read/written with monotonic positive integer values
    match /counters/{name} {
      allow read: if isAuthenticated() && name == 'menuItemId';

      allow create: if isAuthenticated()
        && name == 'menuItemId'
        && request.resource.data.value is int
        && request.resource.data.value > 0;

      allow update: if isAuthenticated()
        && name == 'menuItemId'
        && request.resource.data.value is int
        && request.resource.data.value > resource.data.value;

      allow delete: if false;
    }

    // 6. Orders Collection
    // Read-only for authenticated users (contains cashier names and discount metadata)
    match /orders/{id} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
